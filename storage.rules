rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same room-membership model as firestore.rules' isRoomMember(): a
    // roomId is `${uidA}__${uidB}` (sorted), so a signed-in user may only
    // touch media under a room if their own uid is one of its two halves.
    function isRoomMember(roomId) {
      let parts = roomId.split('__');
      return request.auth != null && parts.size() == 2 &&
        (request.auth.uid == parts[0] || request.auth.uid == parts[1]);
    }

    match /rooms/{roomId}/media/{kind}/{fileName} {
      allow read, write: if isRoomMember(roomId);
    }
  }
}
