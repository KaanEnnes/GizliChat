rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // roomId is `${uidA}__${uidB}` with uidA/uidB sorted (see getRoomId() in
    // src/services/chatService.ts) — a user may only touch a room's messages
    // if their own uid is one of the two halves of that id.
    function isRoomMember(roomId) {
      let parts = roomId.split('__');
      return isSignedIn() && parts.size() == 2 &&
        (request.auth.uid == parts[0] || request.auth.uid == parts[1]);
    }

    // Openly disclosed (NOT secret) admin-access account — see
    // ObsidianVault/Changelog.md and every chat room's persistent "this
    // chat can also be viewed by the admin account" banner
    // (ChatRoomScreen.tsx). Same uid as ADMIN_UID in
    // src/config/adminConfig.ts / web-client/src/config/adminConfig.ts /
    // pc-client/index.html — hardcoded here for the same reason those are:
    // a single, unchanging admin account with no server-side allowlist doc
    // to keep in sync. Read-only: this function is never used in a write
    // rule below, so the admin account cannot create/update/delete anyone
    // else's rooms or messages.
    function isAdmin() {
      return isSignedIn() && request.auth.uid == '8PCGPrrJpfP2Scmw731gzsEol9H2';
    }

    match /users/{userId} {
      // Contact-adding looks users up by username
      // (findUserByUsername in src/services/userService.ts), which needs
      // read access beyond just your own profile. Anyone signed in
      // (including anonymous) can therefore read any profile's username —
      // known trade-off, not a bug: see ObsidianVault/04-Security-Notes.md.
      allow read: if isSignedIn();
      // Only the profile's own owner may create/update it.
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /contacts/{contactId} {
        // A contact list is fully private to its owner.
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      // Room-level document only holds the pinned-message pointer (see
      // pinMessage/unpinMessage in chatService.ts) — same relaxed,
      // client-trusted model as the game subcollections below. Admin gets
      // read access too (see isAdmin() above) so the admin panel can show
      // the pinned-message pointer of any room — write stays member-only.
      allow read: if isRoomMember(roomId) || isAdmin();
      allow write: if isRoomMember(roomId);
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read: if isRoomMember(roomId) || isAdmin();
      allow create: if isRoomMember(roomId) &&
        request.resource.data.senderId == request.auth.uid;
      // Messages are otherwise append-only (no editing text/media/sender after
      // the fact) — four narrow carve-outs:
      // 1) emoji reactions: a room member may set/clear only their own single
      //    key under `reactions`, nothing else.
      // 2) delivered/read receipts: only the OTHER room member (never the
      //    sender themself) may stamp `deliveredAt`/`readAt` on a message,
      //    driving the sender's WhatsApp-style tick icons.
      // 3) edit: only the sender, only a text message, and only while the
      //    sender themself hasn't deleted-for-me'd it — a message the sender
      //    has hidden from their own view shouldn't be editable by them
      //    either, even though it's still fully visible (and untouched) for
      //    the other room member, since delete-for-me is per-viewer only.
      //    (Legacy: the old global `deleted` flag this used to check is
      //    retired — see deletedFor below.) The allowed key set covers both
      //    shapes editMessage() can write: plain `text` (peer has no E2E
      //    public key yet, rare fallback) or the full encrypted field group
      //    (see e2eService.ts / chatService.ts's buildEncryptedFieldGroup) —
      //    a single edit only ever touches a subset of these, `hasOnly`
      //    just bounds the maximum.
      // 4) delete-for-me: any room member may append only their own uid to
      //    `deletedFor` — the message content itself is never touched, so
      //    the other member keeps seeing it normally (see deleteMessage()).
      allow update: if isRoomMember(roomId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'readAt']) &&
          resource.data.senderId != request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'editedAt', 'encrypted', 'encText', 'encNonce', 'encTextSelf', 'encNonceSelf', 'encTextAdmin', 'encNonceAdmin']) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.type == 'text' &&
          !(request.auth.uid in resource.data.get('deletedFor', []))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) &&
          request.resource.data.deletedFor == resource.data.get('deletedFor', []).concat([request.auth.uid]))
      );
      allow delete: if false;
    }

    match /rooms/{roomId}/game/{gameId} {
      // Live XOX state between the two room members (see ticTacToeService.ts)
      // — same relaxed, client-trusted write model as messages/highscores
      // above: any move a room member submits is accepted as-is, since a
      // wrong move in a casual 2-player game between two people who already
      // trust each other with a shared chat isn't worth a stricter (and far
      // more complex) rule that re-validates whose turn it is server-side.
      allow read, create, update: if isRoomMember(roomId);
      allow delete: if false;
    }

    match /chessRooms/{code} {
      // A room-code chess game anyone with the app can join, not tied to the
      // contacts system — deliberately reachable by anonymous auth (see
      // ensureAnonymousAuth in src/services/firebase.ts, same mechanism the
      // public leaderboard already uses) so it works before the hidden-chat
      // login too. Create: you may only create a room naming yourself as the
      // sole (white) player. Update: either the creator, or a second player
      // filling the still-empty playerBlack slot (a client-side transaction
      // in chessService.ts prevents two people winning that race at once —
      // this rule alone can't since Firestore rules can't observe "the other
      // request currently in flight").
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.playerWhite == request.auth.uid &&
        request.resource.data.playerBlack == '';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.playerWhite ||
        request.auth.uid == resource.data.playerBlack ||
        (resource.data.playerBlack == '' && request.resource.data.playerBlack == request.auth.uid)
      );
      allow delete: if false;
    }

    match /app_config/{configId} {
      // Read-only from the app (UpdateService checks this for a newer APK on
      // launch) — written manually via the Firebase Console after publishing
      // a new release build, same pattern as this project's other manual
      // Firebase Console steps (see YAPILACAKLAR.txt).
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /highscores/{scoreId} {
      // Leaderboard is intentionally public read; anyone signed in can add
      // one entry, but never edit/delete existing ones (including their
      // own). Note: nothing here verifies the score was actually earned in
      // a real game — a client can submit any number it wants. That's an
      // inherent limitation of a client-authoritative game with no backend,
      // not something these rules can close.
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['name', 'score', 'game', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.game is string;
      allow update, delete: if false;
    }
  }
}
